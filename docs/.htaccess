# ─── Drea website · Apache config (Namecheap Stellar) ───

# Serve the custom 404 page
ErrorDocument 404 /404.html

# Enable compression for text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 1 month"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

# Cache-Control fallback via mod_headers
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|json)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# Prevent directory listing
Options -Indexes

# Default charset for text files
AddDefaultCharset UTF-8

# Serve the logo SVG with the correct MIME type (Namecheap sometimes mislabels it)
AddType image/svg+xml .svg

# Serve woff2 with the correct MIME type
AddType font/woff2 .woff2
AddType font/ttf .ttf
